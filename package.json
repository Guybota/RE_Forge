{
  "name": "re-forge",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "ui",
    "desktop",
    "relay"
  ],
  "scripts": {
    "engine:build": "node scripts/mvn.mjs -q -pl engine -am -DskipTests package",
    "engine:smoke": "node scripts/smoke-engine.mjs",
    "engine:smoke-library": "node scripts/smoke-library-top.mjs",
    "engine:smoke-deck-selection": "node scripts/smoke-deck-selection.mjs",
    "engine:smoke-deck-language": "node scripts/smoke-deck-language.mjs",
    "engine:smoke-look": "node scripts/smoke-look-choices.mjs",
    "dev": "concurrently -k -n ui,app \"npm run dev -w ui\" \"wait-on http://localhost:5173 && cross-env RE_FORGE_DEV=1 npm start -w desktop\"",
    "build": "npm run build -w ui",
    "ui:smoke-builder": "node scripts/smoke-builder-stats.mjs",
    "ui:smoke-import": "node scripts/smoke-import-files.mjs",
    "ui:smoke-design": "node scripts/smoke-design-contrast.mjs",
    "ui:smoke-appearance": "node scripts/smoke-appearance.mjs",
    "ui:smoke-home": "node scripts/smoke-home.mjs",
    "ui:smoke-deck-picker": "node scripts/smoke-deck-picker.mjs",
    "ui:smoke-library-choice": "node scripts/smoke-library-choice.mjs",
    "desktop:smoke-startup": "node scripts/smoke-startup.mjs",
    "ui:smoke-guidance": "node scripts/smoke-adventure-guidance.mjs",
    "ui:smoke-sounds": "node scripts/smoke-sounds.mjs",
    "start": "npm start -w desktop",
    "package": "node scripts/package.mjs",
    "package:smoke": "node scripts/smoke-package.mjs",
    "desktop:smoke-assets": "node scripts/smoke-engine-assets.mjs",
    "engine:smoke-campaigns": "node scripts/smoke-campaigns.mjs",
    "engine:smoke-match": "node scripts/smoke-match.mjs",
    "engine:smoke-combat": "node scripts/smoke-combat.mjs",
    "engine:smoke-import": "node scripts/smoke-import.mjs",
    "engine:smoke-online": "node scripts/smoke-online.mjs",
    "relay:dev": "npm run dev -w reforge-relay",
    "relay:smoke": "node scripts/smoke-relay.mjs",
    "engine:smoke-relay": "node scripts/smoke-online.mjs --relay",
    "engine:smoke-online-lobby": "node scripts/smoke-online-lobby.mjs",
    "engine:smoke-relay-drop": "node scripts/smoke-relay-drop.mjs",
    "engine:smoke-settings": "node scripts/smoke-settings.mjs",
    "engine:smoke-autopass": "node scripts/smoke-autopass.mjs",
    "engine:smoke-fastforward": "node scripts/smoke-fastforward.mjs",
    "engine:smoke-dialogs": "node scripts/smoke-dialogs.mjs",
    "engine:smoke-tutor": "node scripts/smoke-tutor.mjs",
    "engine:smoke-limited": "node scripts/smoke-limited.mjs",
    "engine:smoke-images": "node scripts/smoke-images.mjs",
    "engine:smoke-builder": "node scripts/smoke-builder.mjs",
    "engine:smoke-import-fixes": "node scripts/smoke-import-fixes.mjs",
    "ui:smoke-animations": "node scripts/smoke-animations.mjs",
    "engine:smoke-quests": "node scripts/smoke-quests.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "overrides": {
    "miniflare": { "undici": "^7.30.1" }
  }
}
