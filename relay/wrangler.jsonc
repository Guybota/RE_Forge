{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "reforge-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "ratelimits": [{ "name": "CONNECT_LIMIT", "namespace_id": "36743", "simple": { "limit": 30, "period": 60 } }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RelayRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "observability": { "enabled": false }
}
